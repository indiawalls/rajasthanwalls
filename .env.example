# ==============================================================================
# Rajasthanwalls Infratech - Environment Variables Specification
# ==============================================================================

# 1. Primary Site Canonical URL (Must be the primary production domain)
NEXT_PUBLIC_SITE_URL=https://rajasthanwall.com

# 2. Administrative Contact & Security Alerts
ADMIN_EMAIL=indiawallsofficial@gmail.com
NEXT_PUBLIC_WHATSAPP_NUMBER=917820879777

# 3. MongoDB Atlas Database
# Recommended: Direct replica set string (bypasses Windows & ISP SRV DNS ECONNREFUSED)
MONGODB_URI=mongodb://<user>:<password>@<shard-00>:27017,<shard-01>:27017,<shard-02>:27017/RajasthanWallsDB?ssl=true&authSource=admin&replicaSet=<replica-set-name>

# 4. Supabase Auth & Storage
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<your-anon-publishable-key>
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-secret-key>
SUPABASE_BUCKET=RajasthanWalls-Images
NEXT_PUBLIC_IMAGES=https://<project-ref>.supabase.co/storage/v1/object/public/RajasthanWalls-Images

# 5. RAG AI Assistant Engine
RAG_API_URL=https://rag.rajasthanwall.com
RAG_API_FALLBACK_URL=https://rag.rajasthanwall.com

# 6. Transactional & Lead Email System (Resend)
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=onboarding@resend.dev
ADMIN_NOTIFICATION_EMAIL=indiawallsofficial@gmail.com

